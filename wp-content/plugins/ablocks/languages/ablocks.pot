msgid "Expire after (hours, 0 = never)"
msgstr ""

#: src/dashboard/pages/settings/Performance/sections/Caching.js:172
msgid "Allowed query parameters"
msgstr ""

#: src/dashboard/pages/settings/Performance/sections/Caching.js:178
msgid "e.g. lang, currency"
msgstr ""

#: src/dashboard/pages/settings/Performance/sections/Caching.js:194
msgid "Any URL carrying a parameter not listed here is served fresh and never cached. Leave empty unless a parameter genuinely changes the page — this is what stops ?utm_source=… from overwriting the cached copy of a page."
msgstr ""

#: src/dashboard/pages/settings/Performance/sections/Caching.js:205
msgid "Never cache these URLs"
msgstr ""

#: src/dashboard/pages/settings/Performance/sections/Caching.js:211
msgid "e.g. /account/*, /cart"
msgstr ""

#: src/dashboard/pages/settings/Performance/sections/Caching.js:229
msgid "Rebuild pages after saving"
msgstr ""

#: src/dashboard/pages/settings/Performance/sections/Caching.js:230
msgid "After a page is edited, rebuild its cached copy in the background so the next visitor does not pay for the render."
msgstr ""

#: src/dashboard/pages/settings/Performance/sections/Caching.js:239
msgid "Store compressed copies"
msgstr ""

#: src/dashboard/pages/settings/Performance/sections/Caching.js:240
msgid "Write a gzipped copy alongside each cached page. Costs a little disk, and lets the web server send the compressed file directly."
msgstr ""

#: src/dashboard/pages/settings/Performance/sections/Caching.js:249
msgid "Separate mobile cache"
msgstr ""

#: src/dashboard/pages/settings/Performance/sections/Caching.js:250
msgid "Keep a second copy of every page for mobile visitors. Only needed if your theme sends different HTML to phones — responsive CSS does not, so leave this off unless you know otherwise."
msgstr ""

#: src/dashboard/pages/settings/Performance/sections/Caching.js:259
msgid "Cache pages in the background"
msgstr ""

#: src/dashboard/pages/settings/Performance/sections/Caching.js:263
msgid "Every hour, quietly build cached copies of pages nobody has visited yet, a few at a time. Without this a page is only cached once someone waits for it. Pages that can never be cached, like cart and account pages, are dropped after a few tries rather than retried forever."
msgstr ""

#: src/dashboard/pages/settings/Performance/sections/Caching.js:276
msgid "Pages per hour"
msgstr ""

#: src/dashboard/pages/settings/Performance/sections/Caching.js:301
msgid "Move inline CSS into cached files"
msgstr ""

#: src/dashboard/pages/settings/Performance/sections/Caching.js:302
msgid "Block themes print tens of kilobytes of CSS into every page, which the browser cannot reuse between pages. This moves it into files it can cache once and share across your whole site — measured at 110KB down to 69KB per page on Twenty Twenty-Four."
msgstr ""

#: src/dashboard/pages/settings/Performance/sections/Caching.js:315
msgid "Keep CSS inline below (bytes)"
msgstr ""

#: src/dashboard/pages/settings/Performance/sections/Caching.js:336
msgid "Cache header and footer"
msgstr ""

#: src/dashboard/pages/settings/Performance/sections/Caching.js:337
msgid "Reuse the rendered header and footer instead of rebuilding them on every request. Unlike the page cache this also helps logged-in visitors and first-time views. Only logged-out output is shared."
msgstr ""

#: src/dashboard/pages/settings/Performance/sections/Caching.js:350
#: src/dashboard/pages/settings/Performance/sections/Caching.js:394
msgid "Expire after (seconds)"
msgstr ""

#: src/dashboard/pages/settings/Performance/sections/Caching.js:371
msgid "Cache template lookups"
msgstr ""

#: src/dashboard/pages/settings/Performance/sections/Caching.js:372
msgid "Remember which block template each URL uses, instead of scanning the theme and querying the database every request."
msgstr ""

#: src/dashboard/pages/settings/Performance/sections/Caching.js:381
msgid "Inactive: this needs a persistent object cache (Redis or Memcached), which this site does not have. Without one, storing the lookup costs more database queries than repeating it — we measured 81 queries per request cached against 75 uncached — so the setting stays off rather than making your site slower. It will start working on its own if an object cache is added."
msgstr ""

#: src/dashboard/pages/settings/Performance/sections/Fonts.js:47
msgid "Load Google Fonts locally"
msgstr ""

#: src/dashboard/pages/settings/Performance/sections/Fonts.js:48
msgid "To enhance page load speed and protect user privacy, replace Google Fonts CDN links with self-hosted font files. By serving the fonts directly from your own server, you eliminate external requests to Google's servers and maintain full control over font delivery."
msgstr ""

#: src/dashboard/pages/settings/Performance/sections/Fonts.js:58
msgid "While a web font loads, render the text in a locally installed font re-scaled to the web font’s own metrics. The line takes up the same space either way, so nothing jumps when the real font arrives (better CLS). Nothing extra is downloaded."
msgstr ""

#: src/dashboard/pages/settings/Performance/sections/Fonts.js:67
msgid "Font Selection Control"
msgstr ""

#: src/dashboard/pages/settings/Performance/sections/Fonts.js:68
msgid "Limit font options to only the selected ones from 1500+ Google fonts."
msgstr ""

#: src/dashboard/pages/settings/Performance/sections/Fonts.js:78
msgid "Select Fonts"
msgstr ""

#: src/dashboard/pages/settings/Performance/sections/Fonts.js:96
msgid "The Font Usage report — which families and weights each page actually loads — has moved to the Site Scanner, next to the other reports."
msgstr ""

#: src/dashboard/pages/settings/Performance/sections/Fonts.js:101
msgid "Open the Font Usage report"
msgstr ""

#: src/dashboard/pages/settings/Performance/sections/Images.js:27
msgid "Lazy-load images"
msgstr ""

#: src/dashboard/pages/settings/Performance/sections/Images.js:28
msgid "Add loading=\"lazy\" and decoding=\"async\" to images in aBlocks blocks. The first images stay eager (high priority) so the LCP image is not deferred."
msgstr ""

#: src/dashboard/pages/settings/Performance/sections/Images.js:41
msgid "Eager (above-the-fold) images"
msgstr ""

#: src/dashboard/pages/settings/Performance/sections/Images.js:62
msgid "Set image dimensions (reduce layout shift)"
msgstr ""

#: src/dashboard/pages/settings/Performance/sections/Images.js:66
msgid "Add width and height to images that are missing them so the browser reserves space before they load, preventing Cumulative Layout Shift (CLS)."
msgstr ""

#: src/dashboard/pages/settings/Performance/sections/Images.js:75
msgid "Serve responsive images (srcset)"
msgstr ""

#: src/dashboard/pages/settings/Performance/sections/Images.js:76
msgid "Add a srcset/sizes to images so browsers download a right-sized file for the screen instead of the full-size image. Big data saving on mobile."
msgstr ""

#: src/dashboard/pages/settings/Performance/sections/Images.js:85
msgid "Preload the largest image (faster LCP)"
msgstr ""

#: src/dashboard/pages/settings/Performance/sections/Images.js:89
msgid "Preload the first image on the page so the browser starts fetching your largest above-the-fold image sooner, improving Largest Contentful Paint."
msgstr ""

#: src/dashboard/pages/settings/Performance/sections/Images.js:97
msgid "Compression"
msgstr ""

#: src/dashboard/pages/settings/Performance/sections/Images.js:102
msgid "Compression strength"
msgstr ""

#: src/dashboard/pages/settings/Performance/sections/Images.js:113
msgid "1x — gentle, no visible change"
msgstr ""

#: src/dashboard/pages/settings/Performance/sections/Images.js:116
msgid "2x — balanced (recommended)"
msgstr ""

#: src/dashboard/pages/settings/Performance/sections/Images.js:119
msgid "5x — aggressive, smallest files"
msgstr ""

#: src/dashboard/pages/settings/Performance/sections/Images.js:124
msgid "Your original files are always kept, so you can change strength or restore them at any time. Measured on a 1.2 MB photo: 1x saved 25%, 2x saved 44%, 5x saved 63%."
msgstr ""

#: src/dashboard/pages/settings/Performance/sections/Images.js:133
msgid "Save a modern WebP version beside each image, which is usually much smaller. The original stays in place, so nothing that links to it breaks. A WebP is discarded if it would be bigger than the image it replaces."
msgstr ""

#: src/dashboard/pages/settings/Performance/sections/Images.js:142
msgid "Optimize new uploads automatically"
msgstr ""

#: src/dashboard/pages/settings/Performance/sections/Images.js:143
msgid "Compress images as they are added to the media library, so you never have to remember to run this."
msgstr ""

#: src/dashboard/pages/settings/Performance/sections/Images.js:151
msgid "Upload standards"
msgstr ""

#: src/dashboard/pages/settings/Performance/sections/Images.js:156
msgid "Require meaningful filenames"
msgstr ""

#: src/dashboard/pages/settings/Performance/sections/Images.js:157
msgid "Refuse images still named the way a camera or phone named them — IMG_4821.jpg, DSC00123.JPG, \"Screenshot 2024–05–01 at 10.02.33.png\". The upload is rejected with a message explaining what to rename it to. Filenames are read by search engines, and they are what everyone sees when hunting through the media library later."
msgstr ""

#: src/dashboard/pages/settings/Performance/sections/Images.js:166
msgid "Require alt text before an image is used"
msgstr ""

#: src/dashboard/pages/settings/Performance/sections/Images.js:170
msgid "Images with no alt text cannot be inserted from the media library, and a post that still contains one is saved as a draft rather than published, with a list of what to fix."
msgstr ""

#: src/dashboard/pages/settings/Performance/sections/Images.js:178
msgid "Alt text cannot be demanded while a file is uploading — WordPress only creates the field to type it into once the upload has finished. So this stops the image being used instead, which reaches the same result without throwing away a file someone just waited to upload."
msgstr ""

#: src/dashboard/pages/settings/Performance/sections/Images.js:185
msgid "To compress the images already in your library, or to review media that nothing appears to use, open the Site Scanner."
msgstr ""

#: src/dashboard/pages/settings/Performance/sections/Images.js:190
