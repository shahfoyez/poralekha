#: includes/classes/scanner/scanner.php:491
#: includes/classes/scanner/scanner.php:536
#: includes/classes/scanner/scanner.php:563
#: includes/classes/scanner/scanner.php:587
#: includes/classes/scanner/scanner.php:609
#: includes/classes/scanner/scanner.php:629
#: includes/classes/scanner/scanner.php:977
#: src/dashboard/pages/settings/License/index.js:215
msgid "Enabled"
msgstr ""

#: includes/classes/scanner/scanner.php:491
#: includes/classes/scanner/scanner.php:536
#: includes/classes/scanner/scanner.php:563
#: includes/classes/scanner/scanner.php:587
#: includes/classes/scanner/scanner.php:609
#: includes/classes/scanner/scanner.php:629
#: includes/classes/scanner/scanner.php:977
msgid "Not enabled"
msgstr ""

#: includes/classes/scanner/scanner.php:494
msgid "Without it every visitor waits for WordPress to rebuild the page from scratch — loading plugins, parsing blocks and querying the database — even though the result is identical for everyone. This is usually the single biggest speed gain available to a site."
msgstr ""

#: includes/classes/scanner/scanner.php:495
msgid "Turn on \"Full-page cache\" under Performance → Caching."
msgstr ""

#: includes/classes/scanner/scanner.php:510
msgid "Persistent object cache"
msgstr ""

#: includes/classes/scanner/scanner.php:514
msgid "Available"
msgstr ""

#: includes/classes/scanner/scanner.php:515
msgid "Not available (Redis or Memcached)"
msgstr ""

#: includes/classes/scanner/scanner.php:518
msgid "WordPress repeats the same database queries on every request unless something remembers them between requests. Without one, some optimizations are not worth enabling — the template cache stays off for exactly this reason, because storing lookups in the database costs more than it saves."
msgstr ""

#: includes/classes/scanner/scanner.php:519
msgid "Ask your host whether Redis or Memcached is available; most managed WordPress hosts offer it as a one-click add-on. This is optional — the site works well without it."
msgstr ""

#: includes/classes/scanner/scanner.php:533
msgid "Inline CSS moved to cached files"
msgstr ""

#: includes/classes/scanner/scanner.php:539
msgid "Block themes print tens of kilobytes of CSS directly into every page, and the browser cannot reuse any of it when the visitor clicks through to the next page. Measured on Twenty Twenty-Four, that is around 40% of the page weight downloaded again and again."
msgstr ""

#: includes/classes/scanner/scanner.php:540
msgid "Turn on \"Move inline CSS into cached files\" under Performance → Caching."
msgstr ""

#: includes/classes/scanner/scanner.php:560
msgid "Background page caching"
msgstr ""

#: includes/classes/scanner/scanner.php:566
msgid "A page is only cached after someone has already waited for it. With background caching on, pages are built ahead of time so the first visitor gets the fast version too."
msgstr ""

#: includes/classes/scanner/scanner.php:567
msgid "Turn on \"Cache pages in the background\" under Performance → Caching."
msgstr ""

#: includes/classes/scanner/scanner.php:584
msgid "Combined block CSS and JavaScript"
msgstr ""

#: includes/classes/scanner/scanner.php:590
msgid "Each block otherwise loads its own stylesheet and script, so a page with fifteen blocks makes fifteen extra requests before it can finish rendering."
msgstr ""

#: includes/classes/scanner/scanner.php:591
msgid "Turn on \"Enable asset file generation\" under Performance → Assets. Best done once the site is built."
msgstr ""

#: includes/classes/scanner/scanner.php:606
msgid "Deferred JavaScript"
msgstr ""

#: includes/classes/scanner/scanner.php:610
msgid "Scripts that load in the page head stop the browser drawing anything until they have downloaded and run. Deferring them lets the page appear first."
msgstr ""

#: includes/classes/scanner/scanner.php:611
msgid "Turn on \"Defer JavaScript\" under Performance → Assets."
msgstr ""

#: includes/classes/scanner/scanner.php:626
msgid "Lazy-loaded images"
msgstr ""

#: includes/classes/scanner/scanner.php:630
msgid "Every image on the page is downloaded immediately, including ones far below the fold that the visitor may never scroll to."
msgstr ""

#: includes/classes/scanner/scanner.php:631
msgid "Turn on \"Lazy load images\" under Performance → Images."
msgstr ""

#: includes/classes/scanner/scanner.php:654
msgid "Image compression"
msgstr ""

#. translators: 1: images not optimized, 2: images already optimized.
#: includes/classes/scanner/scanner.php:659
#, php-format
msgid "%1$d image(s) not compressed, %2$d already done"
msgstr ""

#. translators: 1: images optimized, 2: space saved.
#: includes/classes/scanner/scanner.php:661
#, php-format
msgid "%1$d image(s) compressed, %2$s saved"
msgstr ""

#: includes/classes/scanner/scanner.php:663
msgid "Images are usually the largest thing on a page. Compressing them typically removes 40-60% of their weight with no visible difference, and your originals are kept so it can be undone."
msgstr ""

#: includes/classes/scanner/scanner.php:665
msgid "Use \"Optimize all images\" under Performance → Images."
msgstr ""

#: includes/classes/scanner/scanner.php:701
msgid "Oversized images"
msgstr ""

#. translators: 1: number of images, 2: widest image in pixels.
#: includes/classes/scanner/scanner.php:705
#, php-format
msgid "%1$d image(s) wider than 2560px (largest is %2$dpx)"
msgstr ""

#: includes/classes/scanner/scanner.php:706
msgid "A photo straight from a phone or camera can be 5000px wide, while the space it fills on screen is rarely more than 1200px. The visitor downloads every one of those extra pixels and the browser throws them away."
msgstr ""

#: includes/classes/scanner/scanner.php:707
msgid "Resize large images before uploading, or set a maximum width so WordPress scales them on upload. Compressing them here helps, but resizing helps far more."
msgstr ""

#: includes/classes/scanner/scanner.php:735
msgid "Image alternative text"
msgstr ""

#. translators: %d: number of images.
#: includes/classes/scanner/scanner.php:739
#, php-format
msgid "%d image(s) have no alt text"
msgstr ""

#: includes/classes/scanner/scanner.php:740
msgid "Alt text is what screen readers announce and what search engines read to understand a picture. Without it those images are invisible to both, and in some regions missing alt text is an accessibility compliance issue."
msgstr ""

#: includes/classes/scanner/scanner.php:741
msgid "Open Media → Library in list view and fill in the Alt Text field. Describe what the image shows; leave it empty only for purely decorative images."
msgstr ""

#: includes/classes/scanner/scanner.php:766
msgid "Possibly unused images"
msgstr ""

#. translators: 1: number of images found in the sample, 2: disk space.
#: includes/classes/scanner/scanner.php:771
#, php-format
msgid "At least %1$d image(s) with no reference found, using %2$s"
msgstr ""

#: includes/classes/scanner/scanner.php:775
msgid "These take up space and slow down backups. This is a suggestion, not a verdict — an image can be used in ways no scan can see, so nothing is deleted without your review."
msgstr ""

#: includes/classes/scanner/scanner.php:776
msgid "Use \"Scan for unused images\" under Performance → Media cleanup. Removal moves files aside so they can be put back."
msgstr ""

#. translators: 1: colour value, 2: number of times used.
#: includes/classes/scanner/scanner.php:826
#, php-format
msgid "%1$s used %2$d times"
msgstr ""

#: includes/classes/scanner/scanner.php:832
msgid "Repeated colours"
msgstr ""

#: includes/classes/scanner/scanner.php:837
msgid "These colours are typed directly into blocks rather than referenced from your global palette. They already behave like brand colours — the only difference is that changing one means editing every block by hand, and nothing keeps them consistent as the site grows."
msgstr ""

#: includes/classes/scanner/scanner.php:838
msgid "These colours already exist in your global palette, but the blocks hold a copy of the value instead of pointing at the preset. Updating the preset will not update these blocks."
msgstr ""

#: includes/classes/scanner/scanner.php:840
msgid "Add each colour to Settings → Editor Options → Global Colors, then select the global colour on those blocks instead of the custom value. Afterwards, turn on the colour lock to stop new ones appearing."
msgstr ""

#: includes/classes/scanner/scanner.php:841
msgid "Re-select the matching global colour on those blocks so they follow the preset."
msgstr ""

#. translators: 1: font description, 2: number of times used.
#: includes/classes/scanner/scanner.php:860
#, php-format
msgid "\"%1$s\" used %2$d times"
msgstr ""

#: includes/classes/scanner/scanner.php:866
msgid "Repeated typography"
msgstr ""

#: includes/classes/scanner/scanner.php:870
msgid "The same typeface, size and weight combination has been set by hand on many blocks. That is a heading style waiting to be named: as it stands, changing your heading size means finding and editing every one of them, and any that get missed drift out of step."
msgstr ""

#: includes/classes/scanner/scanner.php:871
msgid "Define the combination once under Settings → Editor Options → Global Typography, then apply that preset to the blocks. The design-system lock will keep new content on the presets."
msgstr ""

#: includes/classes/scanner/scanner.php:906
msgid "Web fonts in use"
msgstr ""

#. translators: 1: number of font families, 2: number of weights, 3: recommended maximum families.
#: includes/classes/scanner/scanner.php:912
#, php-format
msgid "%1$d font families across %2$d weights — %3$d families is the recommended maximum"
msgstr ""

#. translators: 1: number of font families, 2: number of weights.
#: includes/classes/scanner/scanner.php:919
#, php-format
msgid "%1$d font family/families across %2$d weight(s)"
msgstr ""

#: includes/classes/scanner/scanner.php:924
msgid "Every family and every weight is a separate file the browser must download before text can appear in the right typeface. Two families — one for headings, one for body — covers almost every design; a third is usually a block that kept a theme default or a pattern imported from elsewhere, rather than a decision anyone made."
msgstr ""

#: includes/classes/scanner/scanner.php:927
msgid "Open the Font Usage report under Performance → Fonts to see which pages pull in the extras, then set those blocks to your global typography presets. Turning on the typography lock afterwards stops new ones appearing."
msgstr ""

#: includes/classes/scanner/scanner.php:947
msgid "Self-hosted fonts"
msgstr ""

#: includes/classes/scanner/scanner.php:950
msgid "Fonts are served from this site"
msgstr ""

#: includes/classes/scanner/scanner.php:950
msgid "Fonts are fetched from Google"
msgstr ""

#: includes/classes/scanner/scanner.php:953
msgid "Every visitor makes an extra connection to Google before text can render, and their IP address is shared with a third party — which several European data protection rulings have found unlawful without consent."
msgstr ""

#: includes/classes/scanner/scanner.php:954
msgid "Turn on \"Load Google Fonts locally\" under Performance → Fonts. The files are downloaded once and served from your own server."
msgstr ""

#: includes/classes/scanner/scanner.php:974
#: src/dashboard/pages/settings/Performance/sections/Fonts.js:57
msgid "Zero-shift font fallbacks"
msgstr ""

#: includes/classes/scanner/scanner.php:978
msgid "While a web font loads, text is drawn in a fallback of a different size, so the page visibly jumps when the real font arrives. Google counts that jump against your Core Web Vitals score."
msgstr ""

#: includes/classes/scanner/scanner.php:979
msgid "Turn on \"Zero-shift font fallbacks\" under Performance → Fonts. Nothing extra is downloaded."
msgstr ""

#: includes/classes/scanner/scanner.php:997
msgid "PHP version"
msgstr ""

#. translators: %s: PHP version number.
#: includes/classes/scanner/scanner.php:1001
#, php-format
msgid "Running PHP %s"
msgstr ""

#: includes/classes/scanner/scanner.php:1002
msgid "PHP 8 is roughly twice as fast as PHP 7 for typical WordPress work, and versions below 8.0 no longer receive security fixes."
msgstr ""

#: includes/classes/scanner/scanner.php:1003
msgid "Ask your host to move the site to PHP 8.1 or newer. Test on staging first if you run older plugins."
msgstr ""

#: includes/classes/scanner/scanner.php:1021
msgid "Debug mode"
msgstr ""

#: includes/classes/scanner/scanner.php:1024
msgid "WP_DEBUG is switched on"
msgstr ""

#: includes/classes/scanner/scanner.php:1025
msgid "Debug mode makes WordPress do extra work on every request and can print notices from plugins and themes directly into your pages, occasionally revealing file paths. It is meant for development only."
msgstr ""

#: includes/classes/scanner/scanner.php:1026
msgid "Set WP_DEBUG to false in wp-config.php on the live site. Leave it on for staging."
msgstr ""

#: includes/classes/scanner/scanner.php:1046
msgid "Always-loaded settings"
msgstr ""

#. translators: %s: formatted size.
#: includes/classes/scanner/scanner.php:1050
#, php-format
msgid "%s loaded on every request"
msgstr ""

#: includes/classes/scanner/scanner.php:1052
msgid "WordPress loads these settings from the database before it does anything else, on every single page view. Past roughly 800KB this becomes a measurable delay, and it is usually caused by plugins that were removed without cleaning up after themselves."
msgstr ""

#: includes/classes/scanner/scanner.php:1055
msgid "Have a developer review the largest autoloaded rows in wp_options; leftovers from uninstalled plugins can normally be deleted. Take a database backup first."
msgstr ""

#: includes/classes/scanner/scanner.php:1075
msgid "Permalink structure"
msgstr ""

#: includes/classes/scanner/scanner.php:1078
msgid "URLs are in the plain ?p=123 format"
msgstr ""

#: includes/classes/scanner/scanner.php:1079
msgid "Plain URLs tell neither visitors nor search engines what a page is about, and several caching and SEO features — including sitemap-based cache warming — expect readable URLs."
msgstr ""

#: includes/classes/scanner/scanner.php:1080
msgid "Settings → Permalinks → choose \"Post name\". Set up redirects if the site is already live with the old URLs."
msgstr ""

#: includes/classes/scanner/scanner.php:1104
#: includes/classes/scanner/scanner.php:1115
#: includes/classes/scanner/scanner.php:1131
msgid "Scheduled tasks"
msgstr ""

#: includes/classes/scanner/scanner.php:1107
msgid "Running on time"
msgstr ""

#. translators: %d: number of overdue tasks.
#: includes/classes/scanner/scanner.php:1119
#, php-format
msgid "%d task(s) more than an hour overdue"
msgstr ""

#: includes/classes/scanner/scanner.php:1120
msgid "WordPress runs scheduled work when someone visits the site, so a quiet site can fall behind. Cache pruning, background caching, scheduled posts and email all depend on this."
msgstr ""

#: includes/classes/scanner/scanner.php:1121
msgid "Ask your host to set up a real cron job that calls wp-cron.php every few minutes, then add define( 'DISABLE_WP_CRON', true ); to wp-config.php."
msgstr ""

#: includes/classes/scanner/scanner.php:1134
msgid "WordPress cron is switched off"
msgstr ""

#: includes/classes/scanner/scanner.php:1135
msgid "This is the recommended setup when a real server cron job calls wp-cron.php instead — but if no such job exists, nothing scheduled will ever run: no cache pruning, no background caching, no scheduled posts."
msgstr ""

#: includes/classes/scanner/scanner.php:1136
msgid "Confirm with your host that a cron job calls wp-cron.php every few minutes."
msgstr ""

#: includes/classes/scanner/scanner.php:1151
msgid "XML sitemap"
msgstr ""

#: includes/classes/scanner/scanner.php:1154
msgid "Found and readable"
msgstr ""

#: includes/classes/scanner/scanner.php:1154
msgid "No sitemap could be read"
msgstr ""

#: includes/classes/scanner/scanner.php:1157
msgid "Search engines use a sitemap to discover pages they might otherwise miss, and background cache warming reads it to decide what to build. Neither can work without one."
msgstr ""

#: includes/classes/scanner/scanner.php:1160
msgid "WordPress publishes one at /wp-sitemap.xml unless a plugin or filter has disabled it. Check that the URL loads, or let your SEO plugin generate one."
msgstr ""

#: includes/classes/scanner/scanner.php:1176
msgid "Site icon"
msgstr ""

#: includes/classes/scanner/scanner.php:1179
msgid "No site icon set"
msgstr ""

#: includes/classes/scanner/scanner.php:1180
msgid "The site icon is the small image shown on browser tabs, bookmarks and phone home screens. Without one the site shows a blank page glyph, which looks unfinished next to other tabs."
msgstr ""

#: includes/classes/scanner/scanner.php:1181
msgid "Appearance → Customize → Site Identity, or Settings → General on newer themes. A square image of at least 512×512 works everywhere."
msgstr ""

#: includes/classes/scanner/scanner.php:1209
msgid "Deactivated plugins"
msgstr ""

#. translators: %d: number of inactive plugins.
#: includes/classes/scanner/scanner.php:1213
#, php-format
msgid "%d plugin(s) installed but not active"
msgstr ""

#: includes/classes/scanner/scanner.php:1214
msgid "Inactive plugins do not slow the site down, but their files are still on the server and still need security updates. An abandoned plugin nobody is watching is a common way sites get compromised."
msgstr ""

#: includes/classes/scanner/scanner.php:1215
msgid "Delete the ones you do not intend to use again. Anything you might need later can be reinstalled in seconds."
msgstr ""

#: includes/classes/scanner/scanner.php:1230
msgid "Dashboard file editor"
msgstr ""

#: includes/classes/scanner/scanner.php:1233
msgid "Disabled"
msgstr ""

#: includes/classes/scanner/scanner.php:1233
msgid "Theme and plugin files can be edited from the dashboard"
msgstr ""

#: includes/classes/scanner/scanner.php:1236
msgid "If an administrator account is ever compromised, the built-in editor lets the attacker run any code they like by pasting it into a theme file. It is also an easy way to break a live site with a typo and no undo."
msgstr ""

#: includes/classes/scanner/scanner.php:1237
msgid "Add define( 'DISALLOW_FILE_EDIT', true ); to wp-config.php. Edit files over SFTP or through version control instead."
msgstr ""

#: includes/classes/scanner/scanner.php:1264
msgid "Expired temporary data"
msgstr ""

#. translators: %d: number of expired transients.
#: includes/classes/scanner/scanner.php:1268
#, php-format
msgid "%d expired temporary records still stored"
msgstr ""

#: includes/classes/scanner/scanner.php:1269
msgid "WordPress only clears these when something asks for them again, so they can accumulate for years. They rarely slow pages down, but they inflate every database backup."
msgstr ""

#: includes/classes/scanner/scanner.php:1270
msgid "Most database cleanup plugins remove expired transients safely. Take a backup first."
msgstr ""

#: includes/classes/scanner/scanner.php:1290
msgid "Stored post revisions"
msgstr ""

#. translators: %d: number of revisions.
#: includes/classes/scanner/scanner.php:1294
#, php-format
msgid "%d revisions stored"
msgstr ""

#: includes/classes/scanner/scanner.php:1295
msgid "Every save keeps a full copy of the post. Over years this can become the largest table in the database, which slows backups and some queries. It does not usually slow down page loads."
msgstr ""

#: includes/classes/scanner/scanner.php:1296
msgid "Add define( 'WP_POST_REVISIONS', 10 ); to wp-config.php to cap future revisions. Clearing old ones is safe but should follow a backup."
msgstr ""

