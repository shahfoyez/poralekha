#: src/dashboard/pages/settings/Performance/index.js:139
msgid "Not now"
msgstr ""

#: src/dashboard/pages/settings/Performance/sections/Assets.js:39
msgid "Combine each block's CSS/JS into a single per-page file (inlined when small) instead of loading a separate render-blocking stylesheet per block. Recommended once your site is built."
msgstr ""

#: src/dashboard/pages/settings/Performance/sections/Assets.js:70
msgid "CSS"
msgstr ""

#: src/dashboard/pages/settings/Performance/sections/Assets.js:75
msgid "Inline small page CSS"
msgstr ""

#: src/dashboard/pages/settings/Performance/sections/Assets.js:76
msgid "Inline the generated per-page stylesheet when it is small (under ~50KB) to remove a render-blocking request. Larger stylesheets keep loading as a file."
msgstr ""

#: src/dashboard/pages/settings/Performance/sections/Assets.js:85
msgid "Inline critical CSS"
msgstr ""

#: src/dashboard/pages/settings/Performance/sections/Assets.js:86
msgid "Inline all layout-affecting CSS in the head and load the rest (colors, shadows, hover states) without blocking. Content paints sooner with correct spacing — the deferred CSS is cosmetic only, so it does not shift the layout."
msgstr ""

#: src/dashboard/pages/settings/Performance/sections/Assets.js:95
msgid "Load large page CSS asynchronously"
msgstr ""

#: src/dashboard/pages/settings/Performance/sections/Assets.js:96
msgid "Load the full page stylesheet without blocking rendering (with a no-JS fallback). Uses the same layout-safe critical inline as above, so it will not cause a flash of unstyled content."
msgstr ""

#: src/dashboard/pages/settings/Performance/sections/Assets.js:104
msgid "JavaScript"
msgstr ""

#: src/dashboard/pages/settings/Performance/sections/Assets.js:109
msgid "Defer render-blocking scripts"
msgstr ""

#: src/dashboard/pages/settings/Performance/sections/Assets.js:110
msgid "Add defer to scripts that load in the page head (WordPress utilities and aBlocks scripts) so they no longer block first paint. Execution order is preserved. Third-party scripts are not affected."
msgstr ""

#: src/dashboard/pages/settings/Performance/sections/Assets.js:119
msgid "Delay JavaScript until interaction"
msgstr ""

#: src/dashboard/pages/settings/Performance/sections/Assets.js:120
msgid "Hold aBlocks scripts until the first user interaction (scroll, tap, keypress) or a fallback timeout, reducing main-thread work on load. Third-party scripts are not affected."
msgstr ""

#: src/dashboard/pages/settings/Performance/sections/Assets.js:133
