#: src/dashboard/pages/settings/Performance/sections/Caching.js:103
msgid "Save each rendered page to disk so repeat visitors are served a finished HTML file instead of re-running WordPress, block parsing and theme rendering. Logged-in visitors, carts, previews, searches and password-protected pages are never cached."
msgstr ""

#: src/dashboard/pages/settings/Performance/sections/Caching.js:117
msgid "Cache which pages"
msgstr ""

#: src/dashboard/pages/settings/Performance/sections/Caching.js:131
msgid "All public pages"
msgstr ""

#: src/dashboard/pages/settings/Performance/sections/Caching.js:134
